meta {
  name: Criar cargo
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "{{role_name}}",
    "description": "{{role_description}}",
    "department_id": "{{department_id}}",
    "max_seats": {{role_max_seats}}
  }
}

vars:pre-request {
  role_name: Diretor de Marketing
  role_description: Coordena a diretoria de marketing
  role_max_seats: 1
}

script:post-response {
  if (res.getStatus() === 201)
    bru.setEnvVar("role_id", res.getBody().id);
}
