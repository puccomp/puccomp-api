meta {
  name: Atualizar candidato
  type: http
  seq: 2
}

put {
  url: {{base_url}}/v1/recruitment/candidates/{{candidate_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "full_name": "Novo Nome do Candidato",
    "email": "candidato.atualizado@email.com",
    "phone": "31999999999",
    "linkedin_url": "https://linkedin.com/in/novo-link",
    "portfolio_url": "https://portfolio.com/novo-link"
  }
}

docs {
  Substituição total: campo opcional ausente limpa o valor.
}
