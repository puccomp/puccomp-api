meta {
  name: Criar candidato
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/recruitment/candidates
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "full_name": "Candidato Teste",
    "email": "[EMAIL_ADDRESS]",
    "phone": "31999999999",
    "linkedin_url": "https://linkedin.com/in/candidatoteste",
    "portfolio_url": "https://portfolio.com/candidatoteste",
    
  }
}

script:post-response {
  if (res.getStatus() === 201)
    bru.setEnvVar("process_id", res.getBody().id);
}
