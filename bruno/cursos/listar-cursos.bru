meta {
  name: Listar cursos
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v1/courses
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody().length > 0)
    bru.setEnvVar("course_id", res.getBody()[0].id);
}
