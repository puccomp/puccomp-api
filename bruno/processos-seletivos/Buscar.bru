meta {
  name: Buscar
  type: http
  seq: 3
}

get {
  url: {{base_url}}/v1/recruitment/processes/{{process_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  O detalhe traz a description completa e, como a listagem, application_count e
  last_application_at. As alterações devolvem o processo sem esses dois campos.
}
