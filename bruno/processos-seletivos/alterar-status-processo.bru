meta {
  name: Alterar status do processo
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/v1/recruitment/processes/{{process_id}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "status": "OPEN"
  }
}

docs {
  Transições válidas: DRAFT → OPEN → CLOSED.
  CANCELLED é alcançável a partir de DRAFT ou OPEN.

  Só um processo OPEN aparece na superfície pública e aceita inscrições.
}
