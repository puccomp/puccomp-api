meta {
  name: Atualizar processo seletivo
  type: http
  seq: 4
}

put {
  url: {{base_url}}/v1/recruitment/processes/{{process_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "title": "Processo Seletivo 2026.1 (Atualizado)",
    "description": "Edital atualizado do processo seletivo",
    "opens_at": "2026-08-01T00:00:00Z",
    "closes_at": "2026-09-15T23:59:59Z"
  }
}
