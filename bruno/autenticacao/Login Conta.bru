meta {
  name: Login Conta
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{account_email}}",
    "password": "{{account_password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200)
    bru.setEnvVar("access_token", res.getBody().access_token);

}

docs {
  A conta é global (login reutilizável entre EJs). Com um único vínculo, o login seleciona a EJ
  sozinho. Se a conta pertencer a várias EJs, informe "organization_id" no corpo para desambiguar (senão 409).
}
