meta {
  name: Reenviar convite
  type: http
  seq: 4
}

post {
  url: {{base_url}}/v1/invitations/{{invitation_id}}/resend
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Gera um NOVO token/link (o link antigo deixa de funcionar) e estende a validade. O novo inv_...
  cai no Mailpit: http://localhost:8025. Rejeita convite já aceito ou revogado (409).
}
