meta {
  name: Aceitar convite
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/invitations/accept
  body: json
  auth: none
}

body:json {
  {
    "token": "{{invite_token}}",
    "password": "{{invitee_password}}",
    "name": "{{invitee_name}}",
    "course_id": "{{course_id}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) 
    bru.setEnvVar("access_token", res.getBody().access_token);
}
