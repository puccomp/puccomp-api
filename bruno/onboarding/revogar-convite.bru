meta {
  name: Revogar convite
  type: http
  seq: 5
}

delete {
  url: {{base_url}}/v1/invitations/{{invitation_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Invalida um convite em aberto, derrubando o link de aceitação (204 No Content). Idempotente;
  rejeita convite já aceito (409).
}
