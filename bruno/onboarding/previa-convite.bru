meta {
  name: Prévia do convite
  type: http
  seq: 2
}

get {
  url: {{base_url}}/v1/invitations/accept?token={{invite_token}}
  body: none
  auth: none
}

params:query {
  token: {{invite_token}}
}

docs {
  Prévia pública do convite (autenticada apenas pelo token): retorna { organization: {id, name,
  slug}, email, account_exists, courses } para preencher o aceite. Guarda o primeiro curso em
  `course_id`.

  `account_exists` diz o que o campo `password` do aceite significa:
    false → o e-mail ainda não tem conta; o aceite CRIA a conta com a senha enviada
    true  → o e-mail já tem conta (ex.: a pessoa já é membro de outra EJ); o aceite exige a
            SENHA ATUAL dessa conta para vincular. Senha diferente = 401.
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody().courses.length > 0)
    bru.setEnvVar("course_id", res.getBody().courses[0].id);
}
