# Cópia deste arquivo como .env (exatamente esse nome) na máquina do deploy.
# O docker-compose.prod.yml lê .env em duas frentes: para substituir ${DB_USER} e afins
# dentro do próprio compose, e via env_file para injetar tudo no container. Com outro
# nome (.env.prod, por exemplo) a substituição sai vazia e o deploy sobe quebrado.
# O .gitignore cobre .env*, então valores reais nunca sobem para o repositório.

# Banco (o compose usa os mesmos valores para o container do Postgres e para a API)
DB_USER=puccomp
DB_PASS=

# Só é necessário rodando o jar fora do compose: lá dentro, o compose já define
# SPRING_DATASOURCE_URL, que tem precedência sobre este.
# DB_URL=jdbc:postgresql://localhost:5432/puccomp

# Assinatura dos access tokens. Sem isto a aplicação não sobe.
# Precisa de pelo menos 32 bytes: openssl rand -base64 48
JWT_SECRET=

# Chave da superfície administrativa (POST /v1/admin/organizations, que cadastra uma EJ).
# Se ficar vazia o endpoint responde 401 para qualquer chave: openssl rand -hex 32
PUCCOMP_ADMIN_KEY=

# Base do link de aceite que vai no e-mail de convite. Precisa ser alcançável por quem
# recebe o convite, não localhost.
ONBOARDING_ACCEPT_URL=https://ops.puccomp.com.br/aceitar-convite

# Base do link de redefinição de senha. Mesma regra do de cima: é a página do FRONT que recebe
# o ?token=, não uma rota da API. Sem isto a aplicação não sobe.
PASSWORD_RESET_URL=https://ops.puccomp.com.br/redefinir-senha

# Remetente de todo email transacional (convite, confirmação de inscrição).
# Precisa ser um endereço verificado no SES, senão o envio é recusado.
MAIL_FROM=nao-responda@puccomp.com.br

# Origens do FRONT que o navegador pode usar para chamar a API. Lista separada por vírgula.
# É a origem de quem chama, não a da API (que fica em api.puccomp.com.br).
# Sem o domínio aqui, o front recebe erro de CORS em toda chamada.
CORS_ALLOWED_ORIGINS=https://puccomp.com.br,https://www.puccomp.com.br

# SMTP. Em produção é o endpoint SES da região (ex.: email-smtp.us-east-1.amazonaws.com:587),
# com credencial SMTP do SES — que NÃO é a chave IAM: gera-se em SES > SMTP settings.
# No dev, o perfil `dev` já aponta para o mailpit do compose.yml e ignora estas variáveis.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Grafana
GRAFANA_USER=admin
GRAFANA_PASS=

# Currículos privados (módulo files). Desligado por padrão: sem isto o envio com PDF
# responde 503 e a inscrição só aceita JSON. Antes de ligar, o bucket privado do ambiente
# precisa existir e a aplicação precisa de s3:PutObject/GetObject/DeleteObject nele.
FILES_ENABLED=false
FILES_BUCKET=puccomp-private-prod
AWS_REGION=sa-east-1

# clamd alcançável pela API. O protocolo não autentica nem cifra: restrinja à rede privada.
CLAMAV_HOST=
CLAMAV_PORT=3310
