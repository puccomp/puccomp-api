# Cópia deste arquivo como .env.prod na máquina do deploy. O .gitignore cobre .env*,
# então valores reais nunca sobem para o repositório.

# Banco (o compose usa os mesmos valores para o container do Postgres e para a API)
DB_USER=puccomp
DB_PASS=

# Assinatura dos access tokens. Sem isto a aplicação não sobe.
# Precisa de pelo menos 32 bytes: openssl rand -base64 48
JWT_SECRET=

# Chave da superfície administrativa (POST /v1/admin/tenants, que cadastra uma EJ).
# Se ficar vazia o endpoint responde 401 para qualquer chave: openssl rand -hex 32
PUCCOMP_ADMIN_KEY=

# Base do link de aceite que vai no e-mail de convite. Precisa ser alcançável por quem
# recebe o convite, não localhost.
ONBOARDING_ACCEPT_URL=http://54.211.58.34/aceitar-convite
ONBOARDING_FROM=nao-responda@puccomp.dev

# SMTP. Com SES via role da EC2, host e porta bastam.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Grafana
GRAFANA_USER=admin
GRAFANA_PASS=
